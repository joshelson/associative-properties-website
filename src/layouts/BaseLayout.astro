---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Associative Properties | Design & Design Management in Colorado and Utah',
  description = 'Associative Properties brings interior design, architectural consulting, and project management into one working group across Colorado and Utah.'
} = Astro.props;

const site = 'https://associativeproperties.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Associative Properties',
  url: site,
  logo: `${site}/brand/icon-512.png`,
  image: `${site}/og-image.png`,
  description,
  telephone: '+1-303-997-1264',
  email: 'hello@associativeproperties.com',
  foundingDate: '2009',
  areaServed: [
    { '@type': 'State', name: 'Colorado' },
    { '@type': 'State', name: 'Utah' }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#1E3B34">
    <link rel="canonical" href={site + '/'}>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Associative Properties">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={site + '/'}>
    <meta property="og:image" content={site + '/og-image.png'}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,400&display=swap" rel="stylesheet">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <style is:global>
    *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    :root {
        /* Alpine palette */
        --granite: #22272B;
        --spruce: #1E3B34;
        --spruce-deep: #16302A;
        --snow: #F1F4F3;
        --frost: #E3E9E7;
        --mist: #5E6A66;
        --mist-light: #A9B7B0;
        --rose: #C9506A;
        --rose-light: #EE93A5;
        --line: rgba(34, 39, 43, 0.14);
        --line-light: rgba(241, 244, 243, 0.16);

        --font-display: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif;
        --font-body: 'Newsreader', Georgia, 'Times New Roman', serif;

        --gutter: clamp(16px, 5vw, 64px);
        --max: 1200px;
        --section-y: clamp(80px, 12vw, 160px);
        --ease: cubic-bezier(0.65, 0, 0.35, 1);
    }

    html {
        scroll-behavior: smooth;
        scroll-padding-top: 80px;
    }

    body {
        font-family: var(--font-body);
        font-size: 1.1875rem;
        line-height: 1.65;
        color: var(--granite);
        background: var(--snow);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
    }

    img {
        display: block;
        max-width: 100%;
    }

    a {
        color: inherit;
    }

    .container {
        width: 100%;
        max-width: calc(var(--max) + var(--gutter) * 2);
        margin: 0 auto;
        padding-inline: var(--gutter);
    }

    h1, h2, h3, h4 {
        font-family: var(--font-display);
        font-weight: 500;
        line-height: 1.08;
        letter-spacing: -0.02em;
        font-optical-sizing: auto;
    }

    h2 {
        font-size: clamp(2.25rem, 5vw, 3.75rem);
        max-width: 18ch;
    }

    h3 {
        font-size: clamp(1.375rem, 2.2vw, 1.75rem);
        letter-spacing: -0.015em;
    }

    p {
        max-width: 62ch;
    }

    .kicker {
        display: block;
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 500;
        color: var(--rose);
        margin-bottom: 1.25rem;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 0.95rem 1.6rem;
        border-radius: 999px;
        border: 1.5px solid transparent;
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 550;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s, border-color 0.2s;
    }

    .btn-rose {
        background: var(--rose);
        color: #fff;
    }

    .btn-rose:hover {
        background: #B4405A;
    }

    .btn-ghost {
        border-color: currentColor;
        background: transparent;
        color: inherit;
    }

    .btn-ghost:hover {
        background: rgba(241, 244, 243, 0.1);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }

    .skip-link {
        position: absolute;
        left: 16px;
        top: -100px;
        z-index: 2000;
        background: var(--snow);
        color: var(--granite);
        padding: 0.75rem 1rem;
        font-family: var(--font-display);
    }

    .skip-link:focus {
        top: 16px;
    }

    :focus-visible {
        outline: 2px solid var(--rose);
        outline-offset: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }

        *, *::before, *::after {
            transition-duration: 0.01ms !important;
            animation-duration: 0.01ms !important;
        }
    }
    </style>
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
</body>
</html>
