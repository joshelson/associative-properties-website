---
---

<section id="home" class="hero">
    <div class="hero-grid">
        <div class="hero-content" data-reveal="left">
            <span class="section-badge">Colorado & Utah</span>
            <h1 class="hero-title">Elevating Design Across the Rockies</h1>
            <p class="hero-subtitle">Premier design and design management services creating spaces that inspire and endure.</p>
            <div class="hero-buttons">
                <a href="#contact" class="btn btn-hero-primary">Start Your Project</a>
                <a href="#services" class="btn btn-hero-secondary">Explore Services</a>
            </div>
        </div>
        <div class="hero-image-wrapper" data-reveal="right" data-reveal-delay="200">
            <div class="hero-image-frame">
                <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=800&h=1000&fit=crop&q=80" alt="Modern interior design by Associative Properties" class="hero-image">
            </div>
        </div>
    </div>
    <div class="hero-stats">
        <div class="stat" data-reveal data-reveal-delay="400">
            <span class="stat-number" data-target="50">0</span>
            <span class="stat-label">Projects Completed</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat" data-reveal data-reveal-delay="550">
            <span class="stat-number" data-target="15">0</span>
            <span class="stat-label">Years Experience</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat" data-reveal data-reveal-delay="700">
            <span class="stat-number" data-target="2">0</span>
            <span class="stat-label">States Served</span>
        </div>
    </div>
</section>

<style>
.hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 140px 60px 80px;
    position: relative;
    overflow: hidden;
    background: var(--color-charcoal);
}

.hero-grid {
    max-width: 1140px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 5rem;
}

.hero-content {
    z-index: 2;
    position: relative;
}

.hero .section-badge {
    color: var(--color-brass);
}

.hero .section-badge::before {
    background: var(--color-brass);
}

.hero-title {
    color: var(--color-cream);
    margin-bottom: 1.5rem;
    font-weight: 300;
    letter-spacing: -0.5px;
}

.hero-subtitle {
    font-size: 1.1875rem;
    color: var(--color-ash);
    margin-bottom: 3rem;
    max-width: 520px;
    line-height: 1.8;
}

.hero-buttons {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
}

.btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 14px 32px;
    border-radius: var(--border-radius-sm);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: var(--transition);
    border: none;
    cursor: pointer;
    background: var(--color-brass);
    color: var(--color-white);
}

.btn-hero-primary:hover {
    background: var(--color-brass-light);
    transform: translateY(-1px);
}

.btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 14px 32px;
    border-radius: var(--border-radius-sm);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: var(--transition);
    cursor: pointer;
    background: transparent;
    color: var(--color-cream);
    border: 1.5px solid rgba(250, 248, 245, 0.4);
}

.btn-hero-secondary:hover {
    border-color: var(--color-cream);
    background: rgba(250, 248, 245, 0.1);
    transform: translateY(-1px);
}

/* Hero Image */
.hero-image-wrapper {
    position: relative;
    z-index: 2;
}

.hero-image-frame {
    position: relative;
}

.hero-image-frame::before {
    content: '';
    position: absolute;
    top: -12px;
    right: -12px;
    width: 100%;
    height: 100%;
    border: 1.5px solid var(--color-brass);
    border-radius: var(--border-radius);
    z-index: -1;
}

.hero-image {
    width: 100%;
    height: 520px;
    object-fit: cover;
    border-radius: var(--border-radius);
    display: block;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.hero-image-wrapper:hover .hero-image {
    transform: scale(1.02);
}

/* Stats Bar */
.hero-stats {
    max-width: 1140px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    z-index: 2;
    position: relative;
}

.stat {
    text-align: center;
    padding: 0;
}

.stat-divider {
    width: 1px;
    height: 50px;
    background: rgba(250, 248, 245, 0.15);
}

.stat-number {
    display: block;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 300;
    color: var(--color-brass);
    line-height: 1;
    margin-bottom: 0.5rem;
}

.stat-label {
    font-size: 0.75rem;
    color: var(--color-ash);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 500;
}

@media (max-width: 968px) {
    .hero-grid {
        grid-template-columns: 1fr;
        gap: 3rem;
    }

    .hero-image {
        height: 400px;
    }

    .hero-image-frame::before {
        display: none;
    }
}

@media (max-width: 768px) {
    .hero {
        padding: 120px 30px 60px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: stretch;
    }

    .btn-hero-primary,
    .btn-hero-secondary {
        justify-content: center;
    }

    .hero-stats {
        gap: 2rem;
    }

    .stat-number {
        font-size: 2.5rem;
    }
}

@media (max-width: 480px) {
    .hero {
        padding: 100px 20px 50px;
    }

    .hero-stats {
        flex-direction: column;
        gap: 1.5rem;
    }

    .stat-divider {
        width: 40px;
        height: 1px;
    }
}
</style>

<script>
const stats = document.querySelectorAll('.stat-number');
let statsAnimated = false;

function animateCounter(element) {
    const target = parseInt(element.getAttribute('data-target'));
    let current = 0;
    const increment = target / 60;
    const suffix = target > 10 ? '+' : '';

    const timer = setInterval(() => {
        current += increment;
        if (current >= target) {
            current = target;
            clearInterval(timer);
        }
        element.textContent = Math.floor(current) + suffix;
    }, 25);
}

const statsSection = document.querySelector('.hero-stats');
if (statsSection) {
    const statsObserver = new IntersectionObserver(function(entries) {
        entries.forEach(entry => {
            if (entry.isIntersecting && !statsAnimated) {
                statsAnimated = true;
                stats.forEach((stat, index) => {
                    setTimeout(() => {
                        animateCounter(stat);
                    }, index * 150);
                });
                statsObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.5 });

    statsObserver.observe(statsSection);
}

// Parallax effect on hero image
const heroImage = document.querySelector('.hero-image');

window.addEventListener('scroll', function() {
    if (heroImage) {
        const scrolled = window.pageYOffset;
        const rate = scrolled * 0.08;
        heroImage.style.transform = `scale(${1 + rate * 0.001})`;
    }
});
</script>
