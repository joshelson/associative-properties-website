<section id="top" class="hero">
    <div class="hero-inner container">
        <figure class="equation" data-equation data-state="left">
            <p class="sr-only">Design plus build, grouped together, plus manage, equals design plus build and manage grouped together. However the work is grouped, the result is the same.</p>
            <div class="eq-line" aria-hidden="true">
                <span class="eq-paren" data-paren="open">(</span>
                <span class="eq-term" data-term="a">design</span>
                <span class="eq-op">+</span>
                <span class="eq-term" data-term="b">build</span>
                <span class="eq-paren" data-paren="close">)</span>
                <span class="eq-op">+</span>
                <span class="eq-term" data-term="c">manage</span>
            </div>
            <figcaption class="eq-caption">
                <button type="button" class="eq-button" data-regroup>Regroup</button>
                <span>The result holds.</span>
            </figcaption>
        </figure>

        <div class="hero-copy">
            <h1>Design and design management for the Rockies.</h1>
            <p class="hero-lede">We bring interiors, architecture, and project management into one working group across Colorado and Utah. Group the work however you need. One team answers for all of it.</p>
            <div class="hero-actions">
                <a href="#contact" class="btn btn-rose">Start a project</a>
                <a href="#services" class="btn btn-ghost">See what we do</a>
            </div>
        </div>
    </div>
</section>

<style>
.hero {
    background: var(--spruce);
    color: var(--snow);
    padding: clamp(130px, 18vh, 200px) 0 clamp(72px, 10vw, 120px);
    min-height: 92vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 5.5rem);
}

/* ---- Equation ---- */
.equation {
    container-type: inline-size;
}

.eq-line {
    display: flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: min(9cqi, 8.5rem);
    font-weight: 360;
    font-variation-settings: 'opsz' 96;
    letter-spacing: 0;
    line-height: 1.05;
    white-space: nowrap;
}

.eq-term {
    transition: color 0.7s var(--ease);
}

/* All horizontal space lives on the operator, equal on both sides */
.eq-op {
    margin-inline: 0.3em;
    color: var(--mist-light);
    font-weight: 360;
}

/* Parentheses sit tight against the term they open or close */
.eq-paren {
    color: var(--rose-light);
    font-weight: 360;
}

.eq-paren[data-paren='open'] {
    margin-right: 0.04em;
}

.eq-paren[data-paren='close'] {
    margin-left: 0.04em;
}

/* The term outside the group steps back */
.equation[data-state='left'] [data-term='c'],
.equation[data-state='right'] [data-term='a'] {
    color: var(--mist-light);
}

.eq-caption {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: var(--mist-light);
}

.eq-button {
    font: inherit;
    font-weight: 550;
    color: var(--snow);
    background: none;
    border: 1.5px solid var(--line-light);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    cursor: pointer;
    transition: border-color 0.2s;
}

.eq-button:hover {
    border-color: var(--rose-light);
}

/* ---- Copy ---- */
.hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line-light);
}

.hero-copy h1 {
    font-size: clamp(1.75rem, 4vw, 3.25rem);
    font-weight: 500;
    max-width: 14ch;
}

.hero-lede {
    color: var(--mist-light);
    font-size: 1.25rem;
    line-height: 1.6;
}

.hero-actions {
    grid-column: 2;
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
}

@media (max-width: 860px) {
    .hero-copy {
        grid-template-columns: 1fr;
    }

    .hero-actions {
        grid-column: 1;
    }
}

@media (max-width: 480px) {
    .hero-actions .btn {
        flex: 1 1 100%;
    }
}
</style>

<script>
const eq = document.querySelector<HTMLElement>('[data-equation]');

if (eq) {
    const line = eq.querySelector<HTMLElement>('.eq-line')!;
    const open = line.querySelector<HTMLElement>('[data-paren="open"]')!;
    const close = line.querySelector<HTMLElement>('[data-paren="close"]')!;
    const term = (k: string) => line.querySelector<HTMLElement>(`[data-term="${k}"]`)!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let animating = false;

    // left:  (design + build) + manage
    // right: design + (build + manage)
    const arrange = (state: string) => {
        const [first, last] = state === 'left' ? [term('a'), term('b')] : [term('b'), term('c')];
        first.before(open);
        last.after(close);
        eq.dataset.state = state;
    };

    const regroup = () => {
        if (animating) return;
        const next = eq.dataset.state === 'left' ? 'right' : 'left';
        const items = Array.from(line.children) as HTMLElement[];

        if (reduceMotion.matches) {
            arrange(next);
            return;
        }

        // FLIP: measure, rearrange, then animate from the old positions
        const before = new Map(items.map((el) => [el, el.getBoundingClientRect().left]));
        arrange(next);
        const duration = 800;
        const easing = 'cubic-bezier(0.65, 0, 0.35, 1)';
        animating = true;

        const animations = items.map((el) => {
            const dx = before.get(el)! - el.getBoundingClientRect().left;
            if (Math.abs(dx) < 0.5) return null;
            const frames = [{ transform: `translateX(${dx}px)` }, { transform: 'translateX(0)' }];
            return el.animate(frames, { duration, easing });
        });

        Promise.all(animations.map((a) => a?.finished)).finally(() => {
            animating = false;
        });
    };

    arrange('left');
    eq.querySelector<HTMLButtonElement>('[data-regroup]')?.addEventListener('click', regroup);

    const start = () => {
        if (!reduceMotion.matches) window.setTimeout(regroup, 1400);
    };

    if (document.fonts?.ready) {
        document.fonts.ready.then(start);
    } else {
        start();
    }
}
</script>
