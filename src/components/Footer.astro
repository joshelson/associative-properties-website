---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="footer">
    <div class="container">
        <div class="footer-top">
            <div class="footer-brand">
                <Logo size={56} wordmark={false} />
                <p>Design and design management across Colorado and Utah, since 2009.</p>
            </div>

            <nav class="footer-col" aria-label="Services">
                <h2>Services</h2>
                <ul>
                    <li><a href="#services">Interior design</a></li>
                    <li><a href="#services">Architectural consulting</a></li>
                    <li><a href="#services">Project management</a></li>
                    <li><a href="#services">Creative direction</a></li>
                    <li><a href="#services">Furniture design</a></li>
                    <li><a href="#services">Sustainable design</a></li>
                </ul>
            </nav>

            <div class="footer-col">
                <h2>Where we work</h2>
                <ul>
                    <li>Denver, Colorado</li>
                    <li>Boulder, Colorado</li>
                    <li>Aspen, Colorado</li>
                    <li>Park City, Utah</li>
                    <li>Salt Lake City, Utah</li>
                </ul>
            </div>

            <div class="footer-col">
                <h2>Contact</h2>
                <ul>
                    <li><a href="tel:+13039971264">(303) 997-1264</a></li>
                    <li><a href="mailto:hello@associativeproperties.com">hello@associativeproperties.com</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-wordmark" aria-hidden="true">Associative Properties</div>

        <div class="footer-bottom">
            <p>&copy; {year} Associative Properties. All rights reserved.</p>
            <p><span class="math">(a + b) + c = a + (b + c)</span></p>
        </div>
    </div>
</footer>

<style>
.footer {
    background: var(--granite);
    color: var(--snow);
    padding: clamp(64px, 9vw, 112px) 0 2rem;
    --logo-accent: var(--rose-light);
    overflow: hidden;
}

.footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.35fr);
    gap: 2.5rem;
}

.footer-brand p {
    margin-top: 1.25rem;
    max-width: 28ch;
    color: var(--mist-light);
    font-size: 1.0625rem;
}

.footer-col h2 {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--mist-light);
    margin-bottom: 1rem;
}

.footer-col ul {
    list-style: none;
    font-family: var(--font-display);
    font-size: 1rem;
}

.footer-col li + li {
    margin-top: 0.45rem;
}

.footer-col a {
    text-decoration: none;
    overflow-wrap: anywhere;
}

.footer-col a:hover {
    color: var(--rose-light);
}

.footer-wordmark {
    margin: clamp(3rem, 7vw, 5rem) 0 1.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 9.4vw, 9rem);
    letter-spacing: -0.045em;
    line-height: 0.9;
    white-space: nowrap;
    color: rgba(241, 244, 243, 0.08);
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-light);
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--mist-light);
}

.footer-bottom .math {
    color: var(--rose-light);
}

@media (max-width: 1180px) {
    .footer-top {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
        grid-column: 1 / -1;
    }
}

@media (max-width: 520px) {
    .footer-top {
        grid-template-columns: 1fr;
    }
}
</style>
