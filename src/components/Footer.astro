<footer class="footer">
    <div class="container">
        <div class="footer-content">
            <div class="footer-section">
                <div class="footer-logo">
                    <img src="/images/logo.png" alt="Associative Properties Logo" class="logo">
                    <span>Associative Properties</span>
                </div>
                <p>Creating exceptional spaces across Colorado and Utah with passion, precision, and mountain-inspired design.</p>
            </div>
            <div class="footer-section">
                <h4>Services</h4>
                <ul>
                    <li><a href="#services">Interior Design</a></li>
                    <li><a href="#services">Architectural Consulting</a></li>
                    <li><a href="#services">Project Management</a></li>
                    <li><a href="#services">Creative Direction</a></li>
                    <li><a href="#services">Furniture Design</a></li>
                    <li><a href="#services">Sustainable Design</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Service Areas</h4>
                <ul>
                    <li>Denver, Colorado</li>
                    <li>Boulder, Colorado</li>
                    <li>Aspen, Colorado</li>
                    <li>Park City, Utah</li>
                    <li>Salt Lake City, Utah</li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Contact</h4>
                <ul>
                    <li><a href="tel:3039971264">(303) 997-1264</a></li>
                    <li><a href="mailto:hello@associativeproperties.com">hello@associativeproperties.com</a></li>
                    <li>Serving Colorado & Utah</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2025 Associative Properties. All rights reserved.</p>
            <p>Designing the future, one space at a time.</p>
        </div>
    </div>
</footer>

<style>
.footer {
    background: var(--color-ink);
    color: var(--color-cream);
    padding: 5rem 0 2rem;
}

.footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
}

.footer .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 60px;
}

@media (max-width: 1200px) {
    .footer .container {
        padding: 0 50px;
    }
}

.footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.5rem;
}

.footer-logo .logo {
    width: 36px;
    height: 36px;
    filter: brightness(0) invert(1);
}

.footer-logo span {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.25rem;
}

.footer-section p {
    color: var(--color-ash);
    margin-bottom: 2rem;
    font-size: 0.9375rem;
    line-height: 1.7;
}

.footer-section h4 {
    color: var(--color-cream);
    margin-bottom: 1.25rem;
    font-family: var(--font-primary);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
}

.footer-section ul {
    list-style: none;
}

.footer-section li {
    margin-bottom: 0.625rem;
    color: var(--color-ash);
    font-size: 0.9375rem;
}

.footer-section a {
    color: var(--color-ash);
    text-decoration: none;
    transition: var(--transition);
    font-size: 0.9375rem;
}

.footer-section a:hover {
    color: var(--color-brass);
}

.footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 2rem;
    text-align: center;
}

.footer-bottom p {
    color: var(--color-stone);
    margin-bottom: 0.25rem;
    font-size: 0.8125rem;
}

@media (max-width: 1024px) {
    .footer-content {
        grid-template-columns: 1fr 1fr;
        gap: 2.5rem;
    }
}

@media (max-width: 768px) {
    .footer-content {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .footer-logo {
        justify-content: center;
    }
}
</style>
