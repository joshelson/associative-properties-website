---
const services = [
    {
        title: 'Interior design',
        description: 'Complete interiors from first sketch to final styling, shaped around how you actually live and work.',
        features: ['Space planning and layout', 'Furniture selection and custom pieces', 'Color and material palettes', 'Lighting design']
    },
    {
        title: 'Architectural consulting',
        description: 'Guidance for new construction and renovation, so the vision survives contact with structure and code.',
        features: ['Design and planning', 'Construction documentation', 'Building code compliance', 'Contractor coordination']
    },
    {
        title: 'Project management',
        description: 'One accountable lead who keeps the schedule, the budget, and every trade moving in the same direction.',
        features: ['Timeline and budget control', 'Contractor and vendor coordination', 'Quality control and inspections', 'Progress reporting']
    },
    {
        title: 'Creative direction',
        description: 'A coherent visual identity for brands and hospitality spaces, carried from the logo to the lobby.',
        features: ['Brand identity development', 'Visual merchandising', 'Marketing materials', 'Guest and customer experience']
    },
    {
        title: 'Furniture design',
        description: 'Custom pieces made for one room, built with local makers and finished on site.',
        features: ['Custom furniture design', 'Material selection and sourcing', 'Local artisan collaboration', 'Installation and finishing']
    },
    {
        title: 'Sustainable design',
        description: 'Lower-impact choices that stay beautiful and work hard, from materials to mechanical systems.',
        features: ['Green building materials', 'Energy-efficient systems', 'Waste reduction', 'LEED certification support']
    }
];
---

<section id="services" class="services">
    <div class="container">
        <div class="services-head">
            <span class="kicker">Services</span>
            <h2>Six disciplines, grouped however your project needs them.</h2>
        </div>

        <ul class="service-list">
            {services.map((s) => (
                <li class="service">
                    <h3>{s.title}</h3>
                    <p>{s.description}</p>
                    <ul class="service-features">
                        {s.features.map((f) => <li>{f}</li>)}
                    </ul>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
.services {
    padding: var(--section-y) 0;
    background: var(--frost);
}

.services-head {
    margin-bottom: clamp(3rem, 6vw, 5rem);
}

.service-list {
    list-style: none;
    border-top: 1.5px solid var(--granite);
}

.service {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: 1.25rem 3rem;
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.2s;
}

.service h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 450;
}

.service > p {
    color: #3B4448;
}

.service-features {
    list-style: none;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    color: var(--mist);
    line-height: 1.5;
}

.service-features li + li {
    margin-top: 0.3rem;
}

.service:hover h3 {
    color: var(--rose);
}

@media (max-width: 960px) {
    .service {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    }

    .service-features {
        grid-column: 2;
    }
}

@media (max-width: 640px) {
    .service {
        grid-template-columns: 1fr;
        padding: 1.75rem 0;
    }

    .service-features {
        grid-column: 1;
    }
}
</style>
