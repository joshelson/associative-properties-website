---
const services = [
    {
        icon: 'fa-home',
        title: 'Interior Design',
        description: 'Complete interior design services from concept to completion. We create functional, beautiful spaces that reflect your lifestyle and vision.',
        features: [
            'Space planning and layout design',
            'Furniture selection and custom pieces',
            'Color palette and material selection',
            'Lighting design and installation'
        ]
    },
    {
        icon: 'fa-building',
        title: 'Architectural Consulting',
        description: 'Expert architectural guidance for new construction and renovation projects. We ensure your vision is realized with structural integrity.',
        features: [
            'Architectural design and planning',
            'Construction documentation',
            'Building code compliance',
            'Project coordination with contractors'
        ]
    },
    {
        icon: 'fa-tasks',
        title: 'Project Management',
        description: 'Comprehensive project management services to ensure your design project stays on time, on budget, and exceeds expectations.',
        features: [
            'Timeline and budget management',
            'Contractor and vendor coordination',
            'Quality control and inspections',
            'Progress reporting and communication'
        ]
    },
    {
        icon: 'fa-palette',
        title: 'Creative Direction',
        description: 'Strategic creative direction for brands and businesses looking to establish a cohesive visual identity and memorable customer experience.',
        features: [
            'Brand identity development',
            'Visual merchandising',
            'Marketing material design',
            'Customer experience optimization'
        ]
    },
    {
        icon: 'fa-couch',
        title: 'Furniture Design',
        description: 'Custom furniture design and fabrication services. We create unique pieces that perfectly complement your space and lifestyle.',
        features: [
            'Custom furniture design',
            'Material selection and sourcing',
            'Local artisan collaboration',
            'Installation and finishing'
        ]
    },
    {
        icon: 'fa-seedling',
        title: 'Sustainable Design',
        description: 'Eco-friendly design solutions that minimize environmental impact while maximizing beauty and functionality.',
        features: [
            'Green building materials',
            'Energy-efficient systems',
            'Waste reduction strategies',
            'LEED certification support'
        ]
    }
];
---

<section id="services" class="services">
    <div class="container">
        <div class="section-header section-header--dark">
            <span class="section-badge">What We Do</span>
            <h2>Our Services</h2>
            <p class="section-subtitle">Comprehensive design solutions tailored to your vision</p>
        </div>
        <div class="services-grid">
            {services.map((service, index) => (
                <div class="service-card" data-reveal data-reveal-delay={index * 100}>
                    <div class="service-icon">
                        <i class={`fas ${service.icon}`}></i>
                    </div>
                    <h3>{service.title}</h3>
                    <p>{service.description}</p>
                    <ul>
                        {service.features.map(feature => (
                            <li>{feature}</li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
.services {
    padding: var(--section-padding);
    background: var(--color-charcoal);
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 100%;
}

.service-card {
    background: var(--color-graphite);
    padding: 2.5rem;
    border-radius: var(--border-radius);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

.service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: var(--color-brass);
    transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.service-card:hover::before {
    height: 100%;
}

.service-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.1);
}

.service-icon {
    width: 56px;
    height: 56px;
    background: rgba(184, 150, 62, 0.12);
    border-radius: var(--border-radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.75rem;
}

.service-icon i {
    font-size: 1.375rem;
    color: var(--color-brass);
}

.service-card h3 {
    color: var(--color-cream);
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 400;
}

.service-card > p {
    margin-bottom: 1.75rem;
    font-size: 0.9375rem;
    color: var(--color-ash);
    line-height: 1.75;
}

.service-card ul {
    list-style: none;
}

.service-card li {
    padding: 0.5rem 0;
    color: rgba(250, 248, 245, 0.6);
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.9375rem;
}

.service-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 8px;
    height: 1px;
    background: var(--color-brass);
}

@media (max-width: 768px) {
    .services-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .service-card {
        padding: 2rem;
    }
}
</style>
