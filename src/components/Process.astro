---
const steps = [
    {
        title: 'Discovery',
        description: 'Site visits, conversations about how you live or operate, and an honest look at budget and timeline.'
    },
    {
        title: 'Concept',
        description: 'Mood boards, early layouts, and a few distinct directions to react to before anything is fixed.'
    },
    {
        title: 'Refinement',
        description: 'Materials, specifications, 3D renderings, and samples you can hold, revised until it is right.'
    },
    {
        title: 'Implementation',
        description: 'We coordinate contractors, oversee installation, and check quality at every handoff.'
    },
    {
        title: 'Reveal',
        description: 'Final styling and photography, then ongoing support and care guidance after move-in.'
    }
];
---

<section id="process" class="process">
    <div class="container">
        <div class="process-head">
            <span class="kicker">Process</span>
            <h2>Five steps, one team the whole way through.</h2>
        </div>

        <div class="phases" aria-hidden="true">
            <span class="phase phase-design">Design</span>
            <span class="phase phase-build">Delivery</span>
        </div>

        <ol class="steps">
            {steps.map((step, i) => (
                <li class="step">
                    <span class="step-num">{i + 1}</span>
                    <h3>{step.title}</h3>
                    <p>{step.description}</p>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
.process {
    padding: var(--section-y) 0;
}

.process-head {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
}

/* Phase brackets: steps 1-3 are design, 4-5 are delivery */
.phases {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: 2rem;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    color: var(--rose);
}

.phase {
    position: relative;
    padding: 0 1rem 0.75rem;
    text-align: center;
}

.phase::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 10px;
    border: 1.5px solid currentColor;
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
}

.phase-design { grid-column: 1 / 4; }
.phase-build { grid-column: 4 / 6; }

.steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2rem;
}

.step {
    border-top: 1.5px solid var(--granite);
    padding-top: 1.5rem;
}

.step-num {
    display: block;
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 250;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--rose);
    margin-bottom: 1.5rem;
}

.step h3 {
    font-size: 1.375rem;
    margin-bottom: 0.6rem;
}

.step p {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--mist);
}

@media (max-width: 1000px) {
    .phases {
        display: none;
    }

    .steps {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2.5rem 2rem;
    }
}

@media (max-width: 560px) {
    .steps {
        grid-template-columns: 1fr;
    }

    .step {
        display: grid;
        grid-template-columns: 3.5rem 1fr;
        column-gap: 1rem;
    }

    .step-num {
        grid-row: span 2;
        font-size: 2.75rem;
        margin: 0;
    }
}
</style>
